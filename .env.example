# Runtime and network
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=replace_with_a_random_value_at_least_32_characters
ADMIN_KEY=replace_with_a_separate_random_admin_key
SESSION_TTL_SECONDS=3600
# memory:// is suitable for one local/pilot worker. Use shared storage such as
# redis://host:6379/0 before running multiple workers or backend instances.
RATE_LIMIT_STORAGE_URI=memory://
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# OCLC WorldCat
OCLC_CLIENT_ID=
OCLC_CLIENT_SECRET=
OCLC_FILTERED_MAX_PAGES=4

# Gemini
GEMINI_API_KEY=
GEMINI_MAX_CONCURRENCY=4
ENABLE_SEMANTIC_EMBEDDINGS=false
# Optional. Verify current model availability before enabling embeddings.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
MAX_EMBEDDING_CANDIDATES=24
ENABLE_AI_QUERY_EXPANSION=true
MAX_AI_EXPANDED_QUERIES=3
AI_QUERY_EXPANSION_TIMEOUT_SECONDS=4.0

# Optional article-provider keys
CORE_API_KEY=
S2_API_KEY=
NCBI_API_KEY=

# Cache
ARTICLE_CACHE_TTL_SECONDS=900
ARTICLE_CACHE_MAX_SIZE=200
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=100

# Production example (replace values; do not uncomment blindly):
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://your-frontend.example
# ALLOWED_HOSTS=your-api.example
# RATE_LIMIT_STORAGE_URI=redis://your-redis-host:6379/0
